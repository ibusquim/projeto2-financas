{
  "name": "projeto2-fullstack-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de controle financeiro pessoal - Projeto 2 Full Stack",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:criar": "node database/criar-banco.js",
    "db:migrar": "node database/migrar.js",
    "db:seed": "node database/seed/seed.js",
    "db:preparar": "npm run db:criar && npm run db:migrar && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
