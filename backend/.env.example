# Copie este arquivo para .env e preencha com valores locais.
# NUNCA versionar o .env. NUNCA colocar segredos reais neste arquivo de exemplo.

# Servidor
PORT=3000
NODE_ENV=development

# Origem autorizada do front-end (CORS restrito)
CORS_ORIGIN=http://localhost:5173

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projeto2_financas
DB_USER=postgres
DB_PASSWORD=troque-esta-senha-localmente

# Autenticacao JWT
# Gere um valor aleatorio longo. Exemplo de geracao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-gerado-localmente
JWT_EXPIRACAO=2h

# Rate limit do login
LOGIN_MAX_TENTATIVAS=10
LOGIN_JANELA_MINUTOS=15
